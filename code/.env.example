# Values only. Every setting is declared, with its default, in code/config.py.
# Uncomment a line here only to override that default.

DEBUG=True

# --- LLM (Groq) ------------------------------------------------------------
GROQ_API_KEY=your_actual_groq_api_key_here
GROQ_MODEL_NAME=openai/gpt-oss-120b
# GROQ_BACKUP_MODEL_NAME=

# --- Slack (periodic summary) -------------------------------------------------
# Incoming webhook of the channel that gets the periodic chat summary. Leave it
# unset to run the summary without Slack.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# Seconds to wait for one webhook POST. Required: there is no default in code.
SLACK_TIMEOUT=10
# The Slack message header links to the dashboard. The secret goes in .env only.
# DASHBOARD_BASE_URL=https://zero.smalltech.in/dashboard
DASHBOARD_SECRET=your_dashboard_secret_here
# Days back the summary job looks for sessions that still need a summary.
# SUMMARY_WINDOW_DAYS=7

# --- Scheduler -------------------------------------------------------------
# When the periodic summary job runs: a cron pattern (minute hour day month
# weekday) read in PERIODIC_SUMMARY_TIMEZONE. Default: start of every hour.
# PERIODIC_SUMMARY_CRON=0 * * * *
# PERIODIC_SUMMARY_TIMEZONE=Asia/Kolkata

# --- PostgreSQL ------------------------------------------------------------
# Must end with a slash: config.py appends the database name.
DATABASE_URL=postgresql://<username>:<password>@<IP>:5432/

# --- Flask -----------------------------------------------------------------
# PORT=5001                      # only used by `python app.py`

# --- Chat ------------------------------------------------------------------
# MAX_INPUT_LENGTH=10000
# DEFAULT_DOMAIN=COMMON
# DB_TABLE_NAME=chat_table

# --- Connection pool -------------------------------------------------------
# Small on purpose: the database is a shared instance.
# DB_POOL_MIN_SIZE=1
# DB_POOL_MAX_SIZE=2
# DB_POOL_TIMEOUT=5              # seconds one attempt waits for a connection
# DB_POOL_MAX_IDLE=300           # recycle connections idle this long
# DB_POOL_MAX_LIFETIME=3600
# DB_CONNECT_TIMEOUT=10

# --- Query ceilings --------------------------------------------------------
# DB_STATEMENT_TIMEOUT_MS=10000  # an overloaded DB cannot park a request
# DB_LOCK_TIMEOUT_MS=3000        # fail fast when someone else holds a lock
# DB_IDLE_TX_TIMEOUT_MS=30000
# DB_TCP_USER_TIMEOUT_MS=20000   # detect a silent server (Linux only)
# DB_KEEPALIVES_IDLE=10
# DB_KEEPALIVES_INTERVAL=5
# DB_KEEPALIVES_COUNT=3

# --- Retry and startup -----------------------------------------------------
# DB_RETRY_ATTEMPTS=3
# DB_RETRY_BASE_DELAY=0.5
# DB_RETRY_MAX_DELAY=4
# DB_RECONNECT_TIMEOUT=10        # caps the pool's background reconnect backoff
# DB_HEALTH_TIMEOUT=5            # budget for the /health probe
# DB_STARTUP_WAIT=5              # wait for schema before serving anyway
# DB_BOOTSTRAP_ATTEMPTS=60
# DB_APPLICATION_NAME=zero-sales-agent   # set per environment to tell
#                                        # prod from staging in pg_stat_activity
